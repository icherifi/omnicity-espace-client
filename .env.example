# Copier en .env.local et renseigner les valeurs. Ne jamais commiter de vraies clés.

# Supabase (clé anon publique : la sécurité repose sur les règles RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API back-end Omnicity (omnicity-express-server) et URL du front
NEXT_PUBLIC_API_BASE_URL=http://localhost:6300
NEXT_PUBLIC_API_URL=http://localhost:6300
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Kelvin : clé privée côté serveur uniquement (routes app/api/kelvin), clé publique pour la carte
KELVIN_API_TOKEN=
NEXT_PUBLIC_KELVIN_API_KEY=

# Mapbox (jeton public pk.*, à restreindre par URL dans le tableau de bord Mapbox)
NEXT_PUBLIC_MAPBOX_TOKEN=
